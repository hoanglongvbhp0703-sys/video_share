# ─── OAuth (tuỳ chọn — chỉ cần nếu dùng Manus OAuth login) ──────────────────
# Nếu bỏ trống, nút "Đăng nhập với Manus" bị ẩn và app dùng /login thay thế
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=

# ─── File Storage (tuỳ chọn — chỉ cần nếu dùng Forge/S3 cho ảnh kênh) ───────
VITE_FRONTEND_FORGE_API_URL=https://forge.butterfly-effect.dev
VITE_FRONTEND_FORGE_API_KEY=
