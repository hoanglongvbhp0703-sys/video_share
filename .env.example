# ─── Database ────────────────────────────────────────────────────────────────
# Supabase: dùng Transaction Pooler (port 6543) cho runtime — tránh EMAXCONNSESSION
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase: dùng Session Pooler (port 5432) cho drizzle-kit (DDL migrations)
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Dùng để ký JWT session token — tối thiểu 32 ký tự ngẫu nhiên
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-minimum-32-characters

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# URL frontend (dùng trong cookie CORS + password reset link)
CLIENT_URL=http://localhost:5173

# ─── File Storage (tuỳ chọn — fallback về local disk nếu bỏ trống) ───────────
# Forge/S3-compatible storage endpoint và API key
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ─── OAuth (tuỳ chọn — chỉ cần nếu dùng Manus OAuth login) ──────────────────
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# ─── AI Chatbot (Groq — free tier, llama-3.3-70b) ────────────────────────────
GROQ_API_KEY=

# ─── Email (SendGrid — primary, free 100 emails/ngày) ───────────────────────
# Ưu tiên dùng SendGrid (hoạt động trên Railway, không cần verify domain).
#
# Setup SendGrid:
#   1. Đăng ký tại https://sendgrid.com (free plan)
#   2. Settings → Sender Authentication → Single Sender Verification
#      → Verify email bạn muốn gửi từ (VD: your-gmail@gmail.com)
#   3. Settings → API Keys → Create API Key (Full Access hoặc Mail Send only)
#   4. Dán API key vào SENDGRID_API_KEY bên dưới
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
# Email đã verify trong SendGrid (phải khớp với email bạn verify ở bước 2)
SENDGRID_FROM=your-gmail@gmail.com

# ─── Email / SMTP Gmail (fallback local dev) ─────────────────────────────────
# Chỉ dùng khi không có SENDGRID_API_KEY. Bị block trên Railway.
# Cách lấy App Password: https://myaccount.google.com/apppasswords
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
