# ─── Database ────────────────────────────────────────────────────────────────
# Supabase: dùng Transaction Pooler (port 6543) cho runtime — tránh EMAXCONNSESSION
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase: dùng Session Pooler (port 5432) cho drizzle-kit (DDL migrations)
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Dùng để ký JWT session token — tối thiểu 32 ký tự ngẫu nhiên
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-minimum-32-characters

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# URL frontend (dùng trong cookie CORS + password reset link)
CLIENT_URL=http://localhost:5173

# ─── File Storage (tuỳ chọn — fallback về local disk nếu bỏ trống) ───────────
# Forge/S3-compatible storage endpoint và API key
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ─── OAuth (tuỳ chọn — chỉ cần nếu dùng Manus OAuth login) ──────────────────
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# ─── AI Chatbot (Groq — free tier, llama-3.3-70b) ────────────────────────────
GROQ_API_KEY=

# ─── Email / SMTP ─────────────────────────────────────────────────────────────
# Dùng để gửi OTP quên mật khẩu qua Gmail SMTP.
# Fallback: log ra console nếu SMTP_USER / SMTP_PASS chưa set.
#
# Cách lấy Gmail App Password (bắt buộc nếu bật 2FA):
#   https://myaccount.google.com/apppasswords
#   → Chọn "Mail" + tên thiết bị → Copy 16 ký tự
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
# Tên và địa chỉ hiển thị trong email gửi đi (tuỳ chọn)
SMTP_FROM_EMAIL=your-gmail@gmail.com
SMTP_FROM_NAME=VideoShare
